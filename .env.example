# =============================================================================
# PropDrive — Environment variables
# =============================================================================
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit `.env.local`. Variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser; all others are server-only.
# =============================================================================

# --- Supabase (required) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# --- Google Maps (property maps / address autocomplete) -----------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-api-key

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=your-resend-key

# --- Twilio (SMS notifications) ----------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# --- OpenAI (AI tools: descriptions, copy, etc.) -----------------------------
OPENAI_API_KEY=your-openai-key

# --- Stripe (optional billing / payments) ------------------------------------
STRIPE_PUBLIC_KEY=your-stripe-key
STRIPE_SECRET_KEY=your-stripe-secret
